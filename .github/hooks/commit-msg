#!/bin/sh
# Validates the commit message header in $1 as a Conventional Commit.
# POSIX shell only — no Node, no Go, no awk.

die() {
  printf 'commit-msg: %s\n' "$1" >&2
  exit 1
}

if [ -n "$1" ]; then
  IFS= read -r header <"$1" || die "subject must not be empty"
else
  IFS= read -r header || die "subject must not be empty"
fi

[ "${#header}" -le 100 ] || die "header must not be longer than 100 characters"

case "$header" in
  *:*) pre=${header%%:*}
       subject=${header#*:} ;;
  *)   die "missing type or subject: header must follow the type(scope): subject form" ;;
esac

# trim leading and trailing whitespace from the subject
subject=$(printf '%s' "$subject" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

[ -n "$subject" ] || die "subject must not be empty"
case "$subject" in
  *.) die "subject must not end with a full stop" ;;
esac

case "$pre" in
  *\(*\))
    type=${pre%%(*}
    scope=${pre#*(}; scope=${scope%%)}
    ;;
  *)
    type=$pre
    scope=
    ;;
esac

case "$type" in
  feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert) ;;
  *) die "type must be one of feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" ;;
esac

case "$scope" in
  "") ;;
  *[A-Z]*) die "scope must be lower-case" ;;
esac
