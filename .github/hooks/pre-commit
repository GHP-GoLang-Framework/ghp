#!/bin/sh
# Formats only the staged .go files and re-stages them, then runs vet
# on the whole Go tree (see the Makefile `lint` target).
staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')

if [ -n "$staged_go_files" ]; then
  gofmt -w $staged_go_files
  git add $staged_go_files
fi

go vet ./src/...
