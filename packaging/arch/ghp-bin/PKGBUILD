# Maintainer: GHP maintainers <maintainers@ghp.dev>
# Static backup of the PKGBUILD goreleaser generates and pushes to AUR on
# every release (aurs in .goreleaser.yml). Only used for manual rebuilds; the
# live source of truth is .goreleaser.yml. x86_64 only: goreleaser publishes a
# single prebuilt archive per release; arm64 users install the source
# package (ghp) instead.
pkgname=ghp-bin
pkgdesc="GHP toolchain — PHP-style templates with real embedded Go (prebuilt)"
url="https://github.com/GHP-GoLang-Framework/ghp"
pkgver=replace-me
pkgrel=1
arch=('x86_64')
license=('MIT')
depends=()
source=("${url}/releases/download/${pkgver}/ghp_${pkgver}_linux_amd64.tar.gz")
sha256sums=('SKIP')

package() {
  install -Dm755 ./ghp "${pkgdir}/usr/bin/ghp"
}